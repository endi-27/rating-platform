# ==============================================================================
# Distributed Reviews & Ratings Platform — Спільні змінні оточення (Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Хостові порти для проксі та сервісів
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 2. Загальні налаштування бекенду (Pydantic Settings: APP_CONFIG__...)
# ------------------------------------------------------------------------------
APP_CONFIG__ENVIRONMENT=local
APP_CONFIG__API__V1_PREFIX=/api/v1
APP_CONFIG__API__CORS_ORIGINS=["http://localhost", "https://localhost", "http://127.0.0.1", "http://localhost:3000", "https://localhost:3000", "http://localhost:5173", "https://localhost:5173", "http://127.0.0.1:3000", "https://127.0.0.1:3000", "http://127.0.0.1:5173", "https://127.0.0.1:5173"]

# Діагностика екземплярів та симуляція затримки для тестування балансування
APP_CONFIG__INSTANCE_ID=backend-1
APP_CONFIG__SIMULATE_LATENCY_MS=0

# ------------------------------------------------------------------------------
# 3. Безпека, JWT та сесії
# ------------------------------------------------------------------------------
APP_CONFIG__AUTH__ACCESS_SECRET_KEY=change-this-ultra-secure-secret-key-min-32-chars-for-jwt-signing
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_CONFIG__AUTH__REFRESH_TOKEN_EXPIRE_DAYS=1
APP_CONFIG__AUTH__REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=7
APP_CONFIG__AUTH__MAX_SESSION_EXPIRATION_DAYS=30
APP_CONFIG__AUTH__BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. PostgreSQL 16+ База даних
# ------------------------------------------------------------------------------
APP_CONFIG__DB__USER=rating_user
APP_CONFIG__DB__PASSWORD=rating_secret_password
APP_CONFIG__DB__NAME=rating_db
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
DB_HOST_PORT=5434
APP_CONFIG__DB__ECHO=0

# ------------------------------------------------------------------------------
# 5. Redis (Кеш, черга задач ARQ)
# ------------------------------------------------------------------------------
APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__PASSWORD=rating_redis_password
APP_CONFIG__REDIS__DATABASES__CACHE=0
APP_CONFIG__REDIS__DATABASES__TASK=1
APP_CONFIG__CACHE__EXPIRE=60
APP_CONFIG__CACHE__TARGETS_EXPIRE=60
APP_CONFIG__CACHE__REVIEWS_EXPIRE=30

# ------------------------------------------------------------------------------
# 6. Фоновий воркер ARQ
# ------------------------------------------------------------------------------
APP_CONFIG__ARQ__MAX_JOBS=10
APP_CONFIG__ARQ__JOB_TIMEOUT=300

# ------------------------------------------------------------------------------
# 7. Шляхи до сховищ, бекапів та логів (Volume mounts)
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
LOGS_DIR=./logs
BACKUPS_DIR=./backups
BACKUP_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# 8. Сідування початкових даних (Superadmin)
# ------------------------------------------------------------------------------
APP_CONFIG__SEED__SUPERADMIN_USERNAME=super_admin
APP_CONFIG__SEED__SUPERADMIN_NAME=Super Administrator
APP_CONFIG__SEED__SUPERADMIN_PASSWORD=super_admin
